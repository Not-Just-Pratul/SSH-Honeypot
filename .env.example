# =============================================================================
# SSH Honeypot + Live Threat Intelligence Dashboard
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Or run the setup script (recommended):
#   bash scripts/setup.sh
#
# Quick start (no API keys needed — honeypot works without them):
#   python -m ssh_honeypot all
# =============================================================================

# --- Honeypot Configuration ---
# Port 2222 avoids needing root (SSH port 22 requires privileges)
HONEYPOT_HOST=0.0.0.0
HONEYPOT_PORT=2222
# Banner mimics a real Ubuntu server to appear legitimate
HONEYPOT_BANNER=SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.4
HONEYPOT_SERVER_VERSION=SSH-2.0-OpenSSH_8.9p1
HONEYPOT_MAX_CONNECTIONS=100
HONEYPOT_CONNECTION_TIMEOUT=30
HONEYPOT_MAX_AUTH_TRIES=3
HONEYPOT_HOST_KEY_PATH=keys/ssh_host_rsa_key
HONEYPOT_REJECT_PASSWORD=true
HONEYPOT_REJECT_PUBLIC_KEY=true
HONEYPOT_REJECT_KEYBOARD_INTERACTIVE=true

# --- Database & Logging ---
DATABASE_PATH=logs/attack_logs.db
CSV_PATH=logs/attack_logs.csv
CSV_ROTATION_SIZE_MB=10
CSV_MAX_BACKUPS=5

# --- GeoIP Configuration ---
# Download GeoLite2 databases (free, requires MaxMind account):
#   1. Sign up at https://www.maxmind.com/en/geolite2/signup
#   2. Get a license key from your account dashboard
#   3. Download City + ASN databases
#   4. Unpack and point these vars to the .mmdb files
#
# Or use the setup script:
#   MAXMIND_LICENSE_KEY=your_key_here bash scripts/setup.sh
#
GEOIP_CITY_DB=data/GeoLite2-City.mmdb
GEOIP_ASN_DB=data/GeoLite2-ASN.mmdb
GEOIP_DEFAULT_COUNTRY=Unknown
GEOIP_DEFAULT_CITY=Unknown
GEOIP_DEFAULT_LAT=0.0
GEOIP_DEFAULT_LON=0.0
GEOIP_DEFAULT_ASN=Unknown
GEOIP_DEFAULT_ORG=Unknown

# --- Threat Intelligence API Keys ---
# All are OPTIONAL — the honeypot runs without them.
# Each key adds enrichment to the dashboard and API.
#
# AbuseIPDB (free tier: 1000 checks/day)
#   Sign up: https://www.abuseipdb.com/register
#   API key: https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2

# VirusTotal (free tier: 500 requests/day, 1 req/sec)
#   Sign up: https://www.virustotal.com/gui/join-us
#   API key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3

# GreyNoise (free tier: 1000 API calls/month)
#   Sign up: https://www.greynoise.io/signup
#   API key: https://console.greynoise.io/access
GREYNOISE_API_KEY=
GREYNOISE_BASE_URL=https://api.greynoise.io/v3

# Shodan (free tier: 1M results/month, 100 search credits)
#   Sign up: https://account.shodan.io/register
#   API key: https://account.shodan.io/
SHODAN_API_KEY=
SHODAN_BASE_URL=https://api.shodan.io

ENABLE_THREAT_SCORE=false
THREAT_SCORE_CACHE_TTL=3600

# --- Alert Notifications (all optional) ---
EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_RECIPIENTS=

# Discord webhook URL from your server's Integrations settings
DISCORD_WEBHOOK_URL=

# Slack webhook URL from your workspace's Incoming Webhooks app
SLACK_WEBHOOK_URL=

# Telegram: create a bot via @BotFather, get token and chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard Configuration ---
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0
DASHBOARD_REFRESH_INTERVAL=5
DASHBOARD_THEME=dark
DASHBOARD_PAGE_TITLE=SSH Honeypot SOC Dashboard
DASHBOARD_PAGE_ICON=🛡️
DASHBOARD_LAYOUT=wide
DASHBOARD_INITIAL_SIDEBAR_STATE=expanded
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8502
API_AUTH_TOKEN=
API_CORS_ORIGIN=*
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60
